# Central Server Port
PORT=3000

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, PWA manifests, and device QR code setups.
APP_URL="https://cmrg.research.org"

# GEMINI_API_KEY: Optional for server-side quality analysis
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# POSTGRESQL & POSTGIS PRODUCTION DATABASE CONFIGURATION
# Set these parameters when connecting to Google Cloud SQL, Neon, Supabase, or AWS RDS PostgreSQL.
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="YOUR_DATABASE_PASSWORD"
SQL_DB_NAME="cmrg_datacollect"
DATABASE_URL="postgres://postgres:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/cmrg_datacollect"

# PRIVATE MEDIA VAULT STORAGE
# Private directory or bucket for encrypted media assets (not publicly accessible)
MEDIA_STORAGE_PATH="./private_vault/media"
MAX_UPLOAD_SIZE_MB=50

# JWT & RSA SECURITY KEYS
# Public and Private PEM keys for client payload encryption
CMRG_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"
CMRG_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
